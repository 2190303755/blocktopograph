<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/world_content_wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context="com.mithrilmania.blocktopograph.WorldActivity"
    tools:showIn="@layout/app_bar_world">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/world_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:name="com.mithrilmania.blocktopograph.map.MapFragment" />

        <androidx.compose.ui.platform.ComposeView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/composer" />
</FrameLayout>
